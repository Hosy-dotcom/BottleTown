			<Item class="ModuleScript" referent="RBX9e221403813f4c4b9d737172d00ced24">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Config = require(game.ReplicatedStorage.BottleTown.Config)
local Inventory = {}
local profiles = {}

local function update(player, profile)
 player:SetAttribute("BottleCount", #profile.bottles)
 player:SetAttribute("BagCapacity", profile.capacity)
 player:SetAttribute("CashCents", profile.cash)
 player:SetAttribute("LindenStars", profile.stars)
end

local function join(player)
 if profiles[player] then return end
 local profile = {bottles={}, capacity=5, cash=0, stars=0}
 profiles[player] = profile
 update(player, profile)
end

Players.PlayerAdded:Connect(join)
Players.PlayerRemoving:Connect(function(player) profiles[player] = nil end)
for _,player in ipairs(Players:GetPlayers()) do join(player) end

function Inventory.collect(player, bottle)
 local profile = profiles[player]
 if not profile then return false, "" end
 if not bottle.cents then
  profile.stars += 1
  update(player, profile)
  return true, "You found the Linden Star! Added to your collection."
 end
 if #profile.bottles >= profile.capacity then
  return false, "Backpack full! Return your bottles at Korn Markt."
 end
 table.insert(profile.bottles, bottle)
 update(player, profile)
 return true, "Collected " .. bottle.name .. " · " .. Config.Money(bottle.cents)
end

function Inventory.redeem(player)
 local profile = profiles[player]
 if not profile then return false, "" end
 local count = #profile.bottles
 if count == 0 then return false, "Collect deposit bottles before returning." end
 local amount = 0
 for _,bottle in ipairs(profile.bottles) do amount += bottle.cents end
 table.clear(profile.bottles)
 profile.cash += amount
 update(player, profile)
 return true, "+" .. Config.Money(amount) .. " · Returned " .. count .. (count == 1 and " bottle" or " bottles")
end

function Inventory.upgrade(player)
 local profile = profiles[player]
 if not profile then return false, "" end
 if profile.capacity == 10 then return false, "You already have the 10-bottle backpack." end
 if profile.cash < Config.UpgradePrice then return false, "The 10-bottle bag costs " .. Config.Money(Config.UpgradePrice) .. "." end
 profile.cash -= Config.UpgradePrice
 profile.capacity = 10
 update(player, profile)
 return true, "Backpack upgraded! You can now carry 10 bottles."
end

return Inventory]]></ProtectedString>
					<string name="ScriptGuid">{040d2a99-59a4-47aa-94a9-41a13e3ea9d1}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Inventory</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">237b5518f116a2300b0e2c2300000de0</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0f49e7d8e61945688dfa19ab52cdddd2">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Config = require(game.ReplicatedStorage.BottleTown.Config)
local Bottles = {}
local rng = Random.new()
local zones = {
 {name="Town", spots={
  {-9,23},{9,25},{-8,4},{8,3},{-10,8},{18,8},{-7,31},{-31,12},{27,19},{23,35},
  {-31,-14},{12,-14},{28,-13},{-28,-40},{16,-41},{40,-41},{63,-14},{-59,-14},
  {-2,36},{18,-7},{-19,-5},
 }},
 {name="Park", spots={
  {54,2},{65,16},{57,25},{48,32},{75,14},{66,31},{46,-1},{54,11},{74,23},{42,27},{74,-4},
 }},
 {name="Meadow", spots={
  {-43,17},{-54,10},{-63,16},{-75,10},{-70,24},{-59,30},{-81,23},{-68,37},{-39,8},{-77,32},{-56,21},
 }},
}

local function cylinder(model, name, root, offset, width, length, color, material)
 local part = Instance.new("Part")
 part.Name = name
 part.Shape = Enum.PartType.Cylinder
 part.Size = Vector3.new(length, width, width)
 part.CFrame = root * CFrame.new(0,offset,0) * CFrame.Angles(0,0,math.pi/2)
 part.Color = color
 part.Material = material
 part.Anchored = true
 part.CanCollide = false
 part.CanTouch = false
 part.Parent = model
 return part
end

function Bottles.start(town, bind)
 local folder = Instance.new("Folder",town)
 folder.Name = "Collectible bottles"
 local active = {}
 local count = 0
 local countsBySource = {Resident=0}
 local ambientTarget = 0
 for _,zone in ipairs(zones) do
  countsBySource[zone.name] = 0
  ambientTarget += Config.BottleZoneTargets[zone.name]
 end
 local mythicalSpawned = false
 local nextId = 0

 local function forget(model)
  local entry = active[model]
  if not entry then return end
  active[model] = nil
  count -= 1
  countsBySource[entry.source] -= 1
 end
 folder.ChildRemoved:Connect(forget)

 local function spawn(x,z,source,forcedType)
  if count >= Config.ActiveLimit then return end
  local position = Vector2.new(x,z)
  for _,entry in pairs(active) do
   if (entry.position-position).Magnitude < 4 then return end
  end
  local mythical = not forcedType and not mythicalSpawned and rng:NextInteger(1,1800) == 1
  local kind = mythical and Config.Mythical or (forcedType or Config.Types[rng:NextInteger(1,#Config.Types)])
  if mythical then mythicalSpawned = true end
  local model = Instance.new("Model")
  nextId += 1
  model.Name = string.format("Bottle_%04d",nextId)
  model:SetAttribute("BottleType",kind.name)
  model:SetAttribute("SpawnSource",source)
  local size = kind.size
  local root = CFrame.new(x,.42*size+.16,z) * CFrame.Angles(0,rng:NextNumber(0,math.pi*2),0) * CFrame.Angles(0,0,.22)
  local material = mythical and Enum.Material.Neon or Enum.Material.SmoothPlastic
  local body = cylinder(model,"Body",root,0,.58*size,.78*size,kind.color,material)
  cylinder(model,"Label",root,.03*size,.593*size,.29*size,kind.label,material)
  cylinder(model,"Shoulder",root,.40*size,.46*size,.18*size,kind.color,material)
  cylinder(model,"Neck",root,.53*size,.25*size,.2*size,kind.color,material)
  cylinder(model,"Cap",root,.66*size,.3*size,.13*size,kind.label,material)
  model.PrimaryPart = body
  local highlight = Instance.new("Highlight",model)
  highlight.DepthMode = Enum.HighlightDepthMode.Occluded
  highlight.FillTransparency = mythical and .58 or 1
  highlight.OutlineColor = kind.label
  highlight.OutlineTransparency = .24
  if mythical then
   local light = Instance.new("PointLight",body)
   light.Color = kind.color
   light.Range = 13
   light.Brightness = 2
  end
  bind(body,kind,function()
   forget(model)
   model:Destroy()
  end)
  active[model] = {position=position,source=source}
  count += 1
  countsBySource[source] += 1
  model.Parent = folder
  return true
 end

 local nextZone = 1
 local function refill(forcedType)
  if count >= Config.ActiveLimit then return end
  for offset = 0,#zones-1 do
   local index = (nextZone+offset-1)%#zones+1
   local zone = zones[index]
   if countsBySource[zone.name] < Config.BottleZoneTargets[zone.name] then
    -- Try each authored spot once so a crowded zone cannot stall a refill.
    local start = rng:NextInteger(1,#zone.spots)
    for step = 0,#zone.spots-1 do
     local spot = zone.spots[(start+step-1)%#zone.spots+1]
     if spawn(spot[1],spot[2],zone.name,forcedType) then
      nextZone = index%#zones+1
      return true
     end
    end
   end
  end
 end

 local startingTypes = {}
 for index = 1,math.min(ambientTarget,Config.ActiveLimit) do
  startingTypes[index] = Config.Types[(index-1)%#Config.Types+1]
 end
 for index = #startingTypes,2,-1 do
  local swap = rng:NextInteger(1,index)
  startingTypes[index],startingTypes[swap] = startingTypes[swap],startingTypes[index]
 end
 for _,kind in ipairs(startingTypes) do
  if not refill(kind) then break end
 end

 task.spawn(function()
  while true do
   task.wait(Config.BottleRefillInterval)
   refill()
  end
 end)
 return function(x,z)
  if countsBySource.Resident < Config.ResidentBottleLimit then
   spawn(x,z,"Resident")
  end
 end
end

return Bottles]]></ProtectedString>
					<string name="ScriptGuid">{33370731-680b-4b2d-89af-2d9a8b0ce67e}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Bottles</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">237b5518f116a2300b0e2c2300000de2</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX9aed330a92294304afbdf61456df9d71">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Config = require(game.ReplicatedStorage.BottleTown.Config)
local Residents = {}
local rng = Random.new()
local scale = Config.ResidentScale
-- The original standing pose put the sole .14 studs above its route origin.
local standingFootOffset = .14
local routes = {
 {name="Mara", color=Color3.fromRGB(204,108,99), points={{-29,29},{-18,16},{-14,7,true},{-24,-10},{-31,7}}},
 {name="Emil", color=Color3.fromRGB(84,130,153), points={
  {49,-3},{57,1},{58,8},{53,7,true},{56,22},{63,29},{54,22},{54,15},{62,11},{59,2},
 }},
 {name="Ada", color=Color3.fromRGB(153,104,165), points={{-29,19},{-42,20,true},{-58,18},{-53,8},{-37,10}}},
}
local function makePart(model,name,size,color)
 local part = Instance.new("Part")
 part.Name = name
 part.Size = size * scale
 part.Color = color
 part.Anchored = true
 part.CanCollide = false
 part.CanQuery = false
 part.CanTouch = false
 part.Material = Enum.Material.SmoothPlastic
 part.Parent = model
 return part
end

local function offset(x,y,z)
 return CFrame.new(x*scale,y*scale,z*scale)
end

function Residents.start(town, discard)
 local folder = Instance.new("Folder",town)
 folder.Name = "Residents"
 local V = Vector3.new
 for index,route in ipairs(routes) do
  local model = Instance.new("Model",folder)
  model.Name = route.name
  local skin = Color3.fromRGB(238,187,144)
  local pants = Color3.fromRGB(57,64,77)
  local torso = makePart(model,"Coat",V(1.15,1.2,.64),route.color)
  local head = makePart(model,"Head",V(.83,.83,.83),skin)
  head.Shape = Enum.PartType.Ball
  local hair = makePart(model,"Hat",V(.88,.43,.88),pants)
  hair.Shape = Enum.PartType.Ball
  local leftLeg = makePart(model,"Left leg",V(.38,.84,.45),pants)
  local rightLeg = makePart(model,"Right leg",V(.38,.84,.45),pants)
  local leftArm = makePart(model,"Left sleeve",V(.32,.88,.42),route.color)
  local rightArm = makePart(model,"Right sleeve",V(.32,.88,.42),route.color)
  local function pose(facing,phase,walking)
   facing *= offset(0,-standingFootOffset,0)
   local swing = walking and math.sin(phase)*.38 or 0
   torso.CFrame = facing*offset(0,1.65,0)
   head.CFrame = facing*offset(0,2.64,0)
   hair.CFrame = facing*offset(0,2.94,.03)
   leftLeg.CFrame = facing*offset(-.29,.98,0)*CFrame.Angles(swing,0,0)*offset(0,-.42,0)
   rightLeg.CFrame = facing*offset(.29,.98,0)*CFrame.Angles(-swing,0,0)*offset(0,-.42,0)
   leftArm.CFrame = facing*offset(-.75,2.1,0)*CFrame.Angles(-swing,0,0)*offset(0,-.41,0)
   rightArm.CFrame = facing*offset(.75,2.1,0)*CFrame.Angles(swing,0,0)*offset(0,-.41,0)
  end
  local points = route.points
  local function position(point) return V(point[1],.14,point[2]) end
  local from = position(points[1])
  pose(CFrame.lookAt(from,position(points[2])),0,false)
  task.spawn(function()
   task.wait(index)
   local i = 2
   while true do
    local point = points[i]
    local target = position(point)
    local duration = (target-from).Magnitude/4
    local direction = (target-from).Unit
    local startTime = os.clock()
    while os.clock()-startTime < duration do
     local elapsed = os.clock()-startTime
     local current = from:Lerp(target,math.clamp(elapsed/duration,0,1))
     pose(CFrame.lookAt(current,current+direction),elapsed*9,true)
     task.wait(.04)
    end
    pose(CFrame.lookAt(target,target+direction),0,false)
    if point[3] then
     task.wait(1.4)
     if rng:NextNumber() < .65 then discard(point[1]+1.4,point[2]-.9) end
     task.wait(1)
    end
    from = target
    i = i%#points+1
   end
  end)
 end
end

return Residents]]></ProtectedString>
					<string name="ScriptGuid">{8936f835-49b9-4c42-8227-cac1061547f2}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Residents</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">237b5518f116a2300b0e2c2300000de4</UniqueId>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX46d7476e1c594f23ae7a692dd78e8854">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local Config = require(game.ReplicatedStorage.BottleTown.Config)
local Feedback = game.ReplicatedStorage.BottleTown.Feedback
local Inventory = require(script.Parent.Inventory)
local Bottles = require(script.Parent.Bottles)
local Residents = require(script.Parent.Residents)
local town = workspace.BottleTown

local function addPrompt(part, action, description, distance)
 local prompt = Instance.new("ProximityPrompt")
 prompt.ActionText = action
 prompt.ObjectText = description
 prompt.MaxActivationDistance = distance
 prompt.RequiresLineOfSight = false
 prompt.KeyboardKeyCode = Enum.KeyCode.E
 prompt.Parent = part
 return prompt
end

local function canInteract(player,part,prompt)
 local character = player.Character
 local root = character and character:FindFirstChild("HumanoidRootPart")
 local humanoid = character and character:FindFirstChildOfClass("Humanoid")
 return root and humanoid and humanoid.Health > 0 and prompt.Enabled
  and part:IsDescendantOf(town) and (root.Position-part.Position).Magnitude <= prompt.MaxActivationDistance+1
end

local discard = Bottles.start(town,function(part,bottle,remove)
 local prompt = addPrompt(part,"Pick up",bottle.name .. (bottle.cents and " · "..Config.Money(bottle.cents) or " · Mythical"),6)
 local claimed = false
 prompt.Triggered:Connect(function(player)
  if claimed or not canInteract(player,part,prompt) then return end
  claimed = true
  local ok,message = Inventory.collect(player,bottle)
  if ok then
   remove()
  else
   claimed = false
  end
  Feedback:FireClient(player,message,ok)
 end)
end)

local station = town["Pfand station"]
local display = station.Display
local displayColor = display.Color
local pulse
local function stationInteraction(model,action,description,callback)
 local part = model.Interaction
 local prompt = addPrompt(part,action,description,8)
 prompt.Triggered:Connect(function(player)
  if not canInteract(player,part,prompt) then return end
  local ok,message = callback(player)
  Feedback:FireClient(player,message,ok)
  if ok and model == station then
   if pulse then pulse:Cancel() end
   display.Color = Color3.fromRGB(255,239,119)
   pulse = TweenService:Create(display,TweenInfo.new(.9),{Color=displayColor})
   pulse:Play()
  end
 end)
end
stationInteraction(station,"Return all bottles","Korn Markt · Pfand",Inventory.redeem)
stationInteraction(town["Equipment shop"],"Upgrade backpack","10 slots · "..Config.Money(Config.UpgradePrice),Inventory.upgrade)
Residents.start(town,discard)]]></ProtectedString>
